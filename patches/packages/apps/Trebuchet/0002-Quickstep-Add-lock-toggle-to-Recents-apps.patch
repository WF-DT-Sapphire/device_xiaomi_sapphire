diff --git a/quickstep/src/com/android/quickstep/util/RecentsLockUtils.java b/quickstep/src/com/android/quickstep/util/RecentsLockUtils.java
new file mode 100644
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/util/RecentsLockUtils.java
@@ -0,0 +1,89 @@
+package com.android.quickstep.util;
+
+import android.content.Context;
+import android.text.TextUtils;
+
+import com.android.launcher3.LauncherPrefs;
+import com.android.quickstep.views.TaskView;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Keeps the list of apps locked in Recents. Locked apps are skipped by Clear all and swipe. */
+public final class RecentsLockUtils {
+    private static final String SEPARATOR = ",";
+
+    private RecentsLockUtils() {}
+
+    /** Returns the "userId|package" keys of all locked apps. */
+    public static Set<String> getLockedKeys(Context context) {
+        String raw = LauncherPrefs.get(context).get(LauncherPrefs.LOCKED_RECENTS_APPS);
+        Set<String> out = new LinkedHashSet<>();
+        if (!TextUtils.isEmpty(raw)) {
+            out.addAll(Arrays.asList(raw.split(SEPARATOR)));
+        }
+        return out;
+    }
+
+    private static String key(int userId, String packageName) {
+        return packageName == null ? "" : userId + "|" + packageName;
+    }
+
+    /** Returns true if any app of the given task view is locked. */
+    public static boolean isTaskViewLocked(Context context, TaskView taskView) {
+        return isTaskViewLocked(getLockedKeys(context), taskView);
+    }
+
+    /** Same as above, reusing an already loaded set of locked keys. */
+    public static boolean isTaskViewLocked(Set<String> locked, TaskView taskView) {
+        if (locked.isEmpty()) {
+            return false;
+        }
+        for (var container : taskView.getTaskContainers()) {
+            var task = container.getTask();
+            if (locked.contains(key(task.key.userId, task.key.getPackageName()))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Adds the task views that are not locked to {@code dismissible}.
+     * Returns true if at least one task view is locked.
+     */
+    public static boolean collectDismissible(Context context,
+            Iterable<? extends TaskView> all, List<TaskView> dismissible) {
+        Set<String> locked = getLockedKeys(context);
+        boolean anyLocked = false;
+        for (TaskView taskView : all) {
+            if (isTaskViewLocked(locked, taskView)) {
+                anyLocked = true;
+            } else {
+                dismissible.add(taskView);
+            }
+        }
+        return anyLocked;
+    }
+
+    /** Locks or unlocks every app of the given task view. */
+    public static void setTaskViewLocked(Context context, TaskView taskView, boolean lock) {
+        Set<String> locked = getLockedKeys(context);
+        for (var container : taskView.getTaskContainers()) {
+            var task = container.getTask();
+            String key = key(task.key.userId, task.key.getPackageName());
+            if (key.isEmpty()) {
+                continue;
+            }
+            if (lock) {
+                locked.add(key);
+            } else {
+                locked.remove(key);
+            }
+        }
+        LauncherPrefs.get(context).put(LauncherPrefs.LOCKED_RECENTS_APPS,
+                TextUtils.join(SEPARATOR, locked));
+    }
+}

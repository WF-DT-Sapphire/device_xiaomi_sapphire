#Disable MTE Async for system server
arm64.memtag.process.system_server=off

# Audio
persist.audio.button_jack.profile=volume
persist.audio.button_jack.switch=0
ro.vendor.audio.notification.single=true
tunnel.audio.encode=true
use.voice.path.for.pcm.voip=true
qcom.hw.aac.encoder=true

# Bluetooth
persist.vendor.btstack.aac_frm_ctl.enabled=true
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false

# Charger
ro.charger.enable_suspend=1

# Brightness Curve
persist.sys.brightness.low.gamma=true

# CNE
persist.vendor.cne.feature=1

# Ftrace
persist.debug.ftrace_events_disable=Yes

# Fingerprint
sys.fp.miui.token=0

# IMS Debugging
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

#system prop for RmNet Data
persist.rmnet.data.enable=true
persist.data.wda.enable=true
persist.data.df.dl_mode=5
persist.data.df.ul_mode=5
persist.data.df.agg.dl_pkt=10
persist.data.df.agg.dl_size=4096
persist.data.df.mux_count=8
persist.data.df.iwlan_mux=9
persist.data.df.dev_name=rmnet_usb0

# Fwk-Detect
ro.vendor.qti.va_aosp.support=1

# HWUI
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.max_texture_allocation_size=209715200
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024
debug.hwui.skia_atrace_enabled=false
config.disable_rtt=true

# Media
media.settings.xml=/vendor/etc/media_profiles_khaje_v0.xml
media.aac_51_output_enabled=true
mmp.enable.3g2=true
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true
vendor.mm.enable.qcom_parser=16777215
persist.mm.enable.prefetch=true

# NTP
persist.backup.ntpServer=0.pool.ntp.org

persist.vendor.camera.privapp.list=com.android.camera,org.lineageos.aperture

# Radio
DEVICE_PROVISIONED=1
persist.rcs.supported=1
persist.vendor.radio.atfwd.start=true
ril.subscription.types=NV,RUIM
ro.telephony.default_network=22,22
telephony.lteOnCdmaDevice=1

# SdCardFS
persist.sys.fuse.passthrough.enable=true

# Sensors
persist.vendor.sensors.enable.mag_filter=true

#
# system prop for opengles version
#
# 196608 is decimal for 0x30000 to report version 3
# 196609 is decimal for 0x30001 to report version 3.1
# 196610 is decimal for 0x30002 to report version 3.2
ro.opengles.version=196610

# ==========================================
# RAM MANAGEMENT
# ==========================================
ro.sys.fw.bg_apps_limit=128
ro.vendor.qti.sys.fw.bg_apps_limit=128
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.bservice_age=10000
ro.vendor.qti.sys.fw.bservice_limit=128

# ==========================================
# RENDERING
# ==========================================
debug.renderengine.backend=skiaglthreaded
debug.hwui.renderer=skiagl
renderthread.skia.reduceopstasksplitting=true

# ==========================================
# DISPLAY / SURFACE FLINGER
# ==========================================
# debug.sf.* / ro.surface_flinger.* / persist.sys.sf.* movidos de vendor.prop
debug.sf.enable_hwc_vds=0
debug.sf.latch_unsignaled=0
debug.sf.auto_latch_unsignaled=0
debug.sf.enable_transaction_tracing=false
debug.sf.defer_refresh_rate_when_off=1
debug.sf.enable_advanced_sf_phase_offset=1
debug.sf.high_fps_early_gl_phase_offset_ns=-5000000
debug.sf.high_fps_early_phase_offset_ns=-5000000
debug.sf.high_fps_late_app_phase_offset_ns=1000000
debug.sf.high_fps_late_sf_phase_offset_ns=-5000000
debug.sf.hw=0
debug.sf.treat_170m_as_sRGB=1
debug.sf.enable_egl_image_tracker=0
debug.sf.frame_rate_multiple_threshold=120
debug.sf.predict_hwc_composition_strategy=0
persist.sys.sf.color_mode=0
persist.sys.sf.color_saturation=1.0
ro.surface_flinger.clear_slots_with_set_layer_buffer=true
ro.surface_flinger.set_touch_timer_ms=0
ro.surface_flinger.set_idle_timer_ms=0
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=true
ro.surface_flinger.use_color_management=true
ro.surface_flinger.wcg_composition_dataspace=143261696
ro.surface_flinger.use_content_detection_for_refresh_rate=false
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.uclamp.min=205

# ==========================================
# ART / PACKAGE MANAGER
# ==========================================
# dalvik.vm.* / pm.dexopt.* movidos de vendor.prop
dalvik.vm.boot-dex2oat-threads=4
dalvik.vm.image-dex2oat-threads=4
dalvik.vm.dex2oat-cpu-set=4,5,6,7
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.dex2oat-minidebuginfo=false
dalvik.vm.minidebuginfo=false
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.first-boot=verify
pm.dexopt.boot-after-ota=verify

# ==========================================
# ZYGOTE / LOG / PERMISSIONS
# ==========================================
zygote.critical_window.minute=10
ro.control_privapp_permissions=enforce
ro.logd.size=256K

# ==========================================
# CRYPTO / INCREMENTAL / DRM
# ==========================================
ro.crypto.allow_encrypt_override=true
ro.crypto.metadata_init_delete_all_keys.enabled=true
ro.crypto.volume.filenames_mode=aes-256-cts
ro.incremental.enable=true
drm.service.enabled=true

# ==========================================
# ZRAM
# ==========================================
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=1440
ro.zram.periodic_wb_delay_hours=24

# ==========================================
# RADIO / POWER SAVING
# ==========================================
persist.radio.add_power_save=1
pm.sleep_mode=1
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1
ro.ril.fast.dormancy.timeout=3
ro.mot.eri.losalert.delay=1000

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

#
# system props for the data modules
#
ro.vendor.use_data_netmgrd=true
persist.vendor.data.mode=concurrent
#system props for time-services
persist.timed.enable=true
